---
import "../styles/app.css";
import { COLLECTIONS, DETECTORS } from "../config/spherex.ts";
import { TARGETS } from "../config/targets.ts";

const dets = Object.entries(DETECTORS).map(([k, v]) => ({ id: Number(k), ...v }));
const targetIcon: Record<string, string> = {
  wise0855: "i-dwarf",
  barnard: "i-star",
  "epsindi-b": "i-pair",
  "epsindi-a": "i-star",
  rwaur: "i-wave",
  rdra: "i-wave",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05070d" />
    <title>Planet X and SPHEREx</title>
    <meta
      name="description"
      content="Flip through NASA SPHEREx infrared snapshots of any spot in the sky and watch brown dwarfs, nearby stars and variable stars give themselves away."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%230b1020'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%23ffb454'/%3E%3Cellipse cx='16' cy='16' rx='14' ry='4' fill='none' stroke='%23ffb454' stroke-width='1.6' transform='rotate(-20 16 16)'/%3E%3C/svg%3E"
    />
  </head>
  <body data-phase="idle">
    <!-- icon sprite (one stroke weight and style everywhere) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-play" viewBox="0 0 24 24"><path d="M8 5.2v13.6a.6.6 0 0 0 .9.5l11-6.8a.6.6 0 0 0 0-1l-11-6.8a.6.6 0 0 0-.9.5Z" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-pause" viewBox="0 0 24 24"><rect x="6.5" y="5" width="4" height="14" rx="1.2" fill="currentColor" stroke="none"/><rect x="13.5" y="5" width="4" height="14" rx="1.2" fill="currentColor" stroke="none"/></symbol>
        <symbol id="i-prev" viewBox="0 0 24 24"><path d="M6 5.5v13"/><path d="M19 6.2v11.6a.5.5 0 0 1-.8.4l-8.2-5.8a.5.5 0 0 1 0-.8l8.2-5.8a.5.5 0 0 1 .8.4Z" fill="currentColor"/></symbol>
        <symbol id="i-next" viewBox="0 0 24 24"><path d="M18 5.5v13"/><path d="M5 6.2v11.6a.5.5 0 0 0 .8.4l8.2-5.8a.5.5 0 0 0 0-.8L5.8 5.8a.5.5 0 0 0-.8.4Z" fill="currentColor"/></symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.2M12 7.8v.1"/></symbol>
        <symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
        <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol>
        <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m6.5 9.5 5.5 5.5 5.5-5.5"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></symbol>
        <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M12 3.5 14 9l5.5 2L14 13l-2 5.5L10 13l-5.5-2L10 9Z"/><path d="M19 3.5v3M17.5 5h3"/></symbol>
        <symbol id="i-bands" viewBox="0 0 24 24"><path d="m12 4 8.5 4.5L12 13 3.5 8.5Z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5"/><path d="m3.5 16.5 8.5 4.5 8.5-4.5"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 4v16h16"/><path d="m8 15 3.5-4.5 3 3L19 7.5"/></symbol>
        <symbol id="i-image" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m5 17 4.5-4 3 2.5 3-3.5L20 16"/></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 4v11M7.5 11 12 15.5 16.5 11M5 19.5h14"/></symbol>
        <symbol id="i-sliders" viewBox="0 0 24 24"><path d="M5 7h9M18 7h1M5 17h1M10 17h9"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></symbol>
        <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.5"/><circle cx="12" cy="12" r="2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3"/></symbol>
        <symbol id="i-dwarf" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5"/><path d="M3 15.5c2.5 2.3 6.2 3.3 10 2.6s7-2.7 8-5.4"/></symbol>
        <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3.5v17M3.5 12h17M6 6l12 12M18 6 6 18" stroke-opacity=".45"/><circle cx="12" cy="12" r="3" fill="currentColor"/></symbol>
        <symbol id="i-pair" viewBox="0 0 24 24"><circle cx="8.5" cy="13.5" r="3.5"/><circle cx="16.5" cy="9" r="2.4"/><path d="M12 11.5l1.6-1" stroke-dasharray="1.5 2"/></symbol>
        <symbol id="i-wave" viewBox="0 0 24 24"><path d="M3 12h3.2l2.3-6.5 3.6 13 2.6-9 1.5 2.5H21"/></symbol>
        <symbol id="i-move" viewBox="0 0 24 24"><circle cx="7" cy="14" r="2.2"/><circle cx="17" cy="9" r="2.2" fill="currentColor"/><path d="M9.5 13 14.6 9.8" stroke-dasharray="1.6 2.2"/></symbol>
        <symbol id="i-fixed" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2.6" fill="currentColor"/><path d="M12 5v2.5M12 16.5V19M5 12h2.5M16.5 12H19" stroke-opacity=".6"/></symbol>
        <symbol id="i-blink" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2.4" fill="currentColor"/><circle cx="12" cy="12" r="5.8" stroke-opacity=".55"/><circle cx="12" cy="12" r="9" stroke-opacity=".25"/></symbol>
      </defs>
    </svg>

    <a class="skip" href="#viewer">Skip to the image viewer</a>

    <header class="top glass">
      <a class="brand" href="./" aria-label="Planet X and SPHEREx, home">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
          <circle cx="16" cy="16" r="7" fill="var(--accent)"></circle>
          <ellipse cx="16" cy="16" rx="14" ry="4" fill="none" stroke="var(--accent)" stroke-width="1.6" transform="rotate(-20 16 16)"></ellipse>
        </svg>
        <span class="brand-name">Planet X <i>and</i> SPHEREx</span>
      </a>
      <nav class="top-actions" aria-label="Site">
        <button class="btn quiet" id="btn-help" type="button" aria-haspopup="dialog">
          <svg class="ic"><use href="#i-info"></use></svg><span>How it works</span>
        </button>
        <button class="btn quiet" id="btn-share" type="button" title="Copy a link to this exact view">
          <svg class="ic"><use href="#i-link"></use></svg><span>Copy link</span>
        </button>
      </nav>
    </header>

    <main class="shell">
      <!-- the 3-step guide: always visible, tells people where they are -->
      <ol class="steps" id="steps" aria-label="Three steps">
        <li class="step" data-step="1" data-state="active">
          <button type="button" class="step-btn" id="step-1">
            <span class="step-dot"><b>1</b><svg class="ic"><use href="#i-check"></use></svg></span>
            <span class="step-text"><strong>Pick a spot</strong><small>An example, or your own coordinates</small></span>
          </button>
        </li>
        <li class="step" data-step="2" data-state="todo">
          <button type="button" class="step-btn" id="step-2">
            <span class="step-dot"><b>2</b><svg class="ic"><use href="#i-check"></use></svg></span>
            <span class="step-text"><strong>Watch it change</strong><small>Play the snapshots like a film</small></span>
          </button>
        </li>
        <li class="step" data-step="3" data-state="todo">
          <button type="button" class="step-btn" id="step-3">
            <span class="step-dot"><b>3</b><svg class="ic"><use href="#i-check"></use></svg></span>
            <span class="step-text"><strong>Dig deeper</strong><small>Highlight changes, compare colours, measure</small></span>
          </button>
        </li>
      </ol>

      <p class="status" id="status" role="status" aria-live="polite"></p>

      <!-- STEP 1 -->
      <section id="welcome" class="welcome" aria-labelledby="hero-title">
        <div class="hero">
          <p class="eyebrow">NASA SPHEREx · near-infrared all-sky survey</p>
          <h1 id="hero-title">Watch the infrared sky change.</h1>
          <p class="lede">
            SPHEREx photographs the whole sky in 102 infrared colours your eyes can't see. Flip through its snapshots of one spot
            and anything that moves gives itself away: brown dwarfs, nearby stars, asteroids and comets.
          </p>
          <ul class="reads" aria-label="How to read the film">
            <li><svg class="ic"><use href="#i-fixed"></use></svg><span><b>Stays put</b> distant stars</span></li>
            <li><svg class="ic"><use href="#i-move"></use></svg><span><b>Drifts</b> something close or fast</span></li>
            <li><svg class="ic"><use href="#i-blink"></use></svg><span><b>Pulses</b> a variable star</span></li>
          </ul>
        </div>

        <div id="picker-home">
          <form id="form-target" class="picker glass" autocomplete="off">
            <div class="picker-head">
              <h2>Where should we look?</h2>
              <p>Tap an example to start instantly.</p>
            </div>

            <div class="tcards" id="tcards" role="group" aria-label="Example targets">
              {
                TARGETS.map((t) => (
                  <button type="button" class="tcard" data-target={t.id}>
                    <span class="tcard-ic"><svg class="ic"><use href={`#${targetIcon[t.id] ?? "i-star"}`}></use></svg></span>
                    <span class="tcard-body">
                      <span class="tcard-kind">{t.kind}</span>
                      <strong>{t.name}</strong>
                      <span class="tcard-hint">{t.hint}</span>
                    </span>
                    <svg class="ic go"><use href="#i-arrow"></use></svg>
                  </button>
                ))
              }
            </div>

            <div class="or"><span>or enter your own</span></div>

            <div class="grid2">
              <label class="field">
                <span class="lbl">Search by name</span>
                <span class="inline">
                  <input id="in-name" type="text" placeholder="e.g. Vega, Proxima Centauri" spellcheck="false" />
                  <button class="btn" id="btn-resolve" type="button"><svg class="ic"><use href="#i-search"></use></svg><span>Find</span></button>
                </span>
              </label>
              <div class="coords">
                <label class="field">
                  <span class="lbl">Right ascension (RA)</span>
                  <input id="in-ra" type="text" inputmode="text" placeholder="08h55m10.8s or 133.795" spellcheck="false" />
                </label>
                <label class="field">
                  <span class="lbl">Declination (Dec)</span>
                  <input id="in-dec" type="text" inputmode="text" placeholder="-7d14m42s or -7.245" spellcheck="false" />
                </label>
              </div>
            </div>
            <p class="help">Any format works: <code>08h55m10.8s</code>, <code>08:55:10.8</code> or plain degrees. Paste “RA Dec” into the first box if you like.</p>

            <label class="field range">
              <span class="lbl">Size of the view <output id="out-fov">4′</output></span>
              <input id="in-fov" type="range" min="1" max="20" step="0.5" value="4" aria-describedby="fov-help" />
              <span class="range-ends" id="fov-help"><span>Close-up · loads fast</span><span>Wide · catches faster movers</span></span>
            </label>

            <details class="more">
              <summary><svg class="ic chev"><use href="#i-chevron"></use></svg>Know how fast it moves? Add its motion</summary>
              <div class="grid3">
                <label class="field"><span class="lbl">μα* (mas/yr)</span><input id="in-pmra" type="number" step="any" value="0" /></label>
                <label class="field"><span class="lbl">μδ (mas/yr)</span><input id="in-pmdec" type="number" step="any" value="0" /></label>
                <label class="field"><span class="lbl">Epoch of coordinates</span><input id="in-epoch" type="number" step="any" value="2000" /></label>
              </div>
              <p class="help">With a known motion the tool marks where the object should be, and can follow it.</p>
            </details>

            <div class="picker-foot">
              <button class="btn primary big" id="btn-load" type="submit">
                <span>Show me the sky</span><svg class="ic"><use href="#i-arrow"></use></svg>
              </button>
              <p class="help">Searching {COLLECTIONS.map((c) => c.label).join(" and ")} at NASA/IPAC IRSA.</p>
            </div>
          </form>
        </div>
      </section>

      <!-- STEPS 2 + 3 -->
      <section id="workspace" class="workspace" hidden>
        <div class="col-main">
          <div class="viewer-card glass" id="viewer">
            <div class="target-bar">
              <div class="tb-text">
                <strong id="tb-name">Target</strong>
                <span id="tb-sub"></span>
              </div>
              <button class="btn subtle" id="btn-change" type="button"><svg class="ic"><use href="#i-target"></use></svg><span>Change spot</span></button>
            </div>

            <div class="stage">
              <canvas id="cv" class="cv" role="img" aria-label="SPHEREx image of the selected patch of sky"></canvas>
              <canvas id="ov" class="cv ov"></canvas>
              <div class="hud tl" id="hud-label"></div>
              <div class="hud bl" id="hud-readout"></div>
              <div class="hud tr" id="hud-flags"></div>
              <div class="loading" id="loading" hidden>
                <div class="bar"><i id="bar"></i></div>
                <span id="loading-text"></span>
              </div>
              <div class="empty" id="empty" hidden>
                <svg class="ic xl"><use href="#i-bands"></use></svg>
                <p>Nothing to show with these settings. Turn on at least one infrared colour.</p>
              </div>
            </div>

            <div class="transport" role="group" aria-label="Playback">
              <button class="btn round" id="btn-prev" type="button" aria-label="Previous snapshot" title="Previous  (←)"><svg class="ic"><use href="#i-prev"></use></svg></button>
              <button class="btn round primary play" id="btn-play" type="button" data-playing="false" aria-label="Play" title="Play / pause  (Space)">
                <svg class="ic i-play"><use href="#i-play"></use></svg>
                <svg class="ic i-pause"><use href="#i-pause"></use></svg>
              </button>
              <button class="btn round" id="btn-next" type="button" aria-label="Next snapshot" title="Next  (→)"><svg class="ic"><use href="#i-next"></use></svg></button>
              <input id="in-frame" type="range" min="0" max="0" step="1" value="0" aria-label="Snapshot number" />
              <span class="frame-count" id="frame-count" aria-live="off">0 / 0</span>
              <label class="fps"><span>Speed</span><input id="in-fps" type="range" min="1" max="20" step="1" value="5" /><output id="out-fps">5 fps</output></label>
              <button class="btn quiet icon-only" id="btn-png" type="button" aria-label="Save this image as PNG" title="Save as PNG"><svg class="ic"><use href="#i-image"></use></svg></button>
            </div>

            <p class="coach" id="coach"></p>

            <div class="next" id="next" aria-label="Suggestions">
              <span class="next-label">Try next</span>
              <button type="button" class="pill" id="act-diff" aria-pressed="false"><svg class="ic"><use href="#i-sparkle"></use></svg><span>Highlight what changed</span></button>
              <button type="button" class="pill" id="act-bands" aria-pressed="false"><svg class="ic"><use href="#i-bands"></use></svg><span>Compare infrared colours</span></button>
              <button type="button" class="pill" id="act-measure"><svg class="ic"><use href="#i-chart"></use></svg><span>Measure brightness</span></button>
            </div>
          </div>
        </div>

        <aside class="tools glass" id="tools" aria-label="Controls">
          <section class="group">
            <h2>What to play</h2>
            <div class="seg" role="radiogroup" aria-label="What to play" data-seg="in-mode">
              <button type="button" role="radio" data-value="frames">Every snapshot</button>
              <button type="button" role="radio" data-value="detector">By colour</button>
              <button type="button" role="radio" data-value="epochs">By visit</button>
            </div>
            <p class="help" id="mode-hint"></p>
            <select id="in-mode" hidden aria-hidden="true" tabindex="-1">
              <option value="frames">Every exposure (blink)</option>
              <option value="detector">One sum per detector</option>
              <option value="epochs">Sum per observing epoch</option>
            </select>
            <label class="field range" id="row-gap" hidden>
              <span class="lbl">Group snapshots taken within <output id="out-gap">5 d</output></span>
              <input id="in-gap" type="range" min="1" max="60" step="1" value="5" />
            </label>
          </section>

          <section class="group">
            <h2>Make movers stand out</h2>
            <label class="switch">
              <input id="tg-diff" type="checkbox" role="switch" />
              <span class="track"><i></i></span>
              <span class="sw-text"><b>Highlight what changed</b><small>Removes what never changes, so movers show as a bright and dark pair.</small></span>
            </label>
            <label class="switch">
              <input id="in-track" type="checkbox" role="switch" />
              <span class="track"><i></i></span>
              <span class="sw-text"><b>Follow the object</b><small id="track-help">Keeps it centred while the stars trail. Needs a known motion.</small></span>
            </label>
          </section>

          <section class="group">
            <h2>Infrared colours</h2>
            <div class="dets" id="dets" role="group" aria-label="Infrared colour bands">
              {
                dets.map((d) => (
                  <label class="det" style={`--c:${d.color}`}>
                    <input type="checkbox" data-det={d.id} checked />
                    <span class="det-name">{d.name}</span>
                    <span class="det-wl">{d.min}–{d.max} µm</span>
                    <span class="det-n" data-detn={d.id} title="snapshots available"></span>
                  </label>
                ))
              }
            </div>
            <p class="help">Cold objects like brown dwarfs are brightest in the reddest bands, D5 and D6.</p>
          </section>

          <section class="group">
            <h2>Show on the image</h2>
            <label class="switch compact"><input id="ov-gaia" type="checkbox" role="switch" checked /><span class="track"><i></i></span><span class="sw-text"><b><i class="sw gaia"></i>Known stars (Gaia)</b></span></label>
            <label class="switch compact"><input id="ov-pred" type="checkbox" role="switch" checked /><span class="track"><i></i></span><span class="sw-text"><b><i class="sw pred"></i>Where the object should be</b></span></label>
            <label class="switch compact"><input id="ov-ap" type="checkbox" role="switch" checked /><span class="track"><i></i></span><span class="sw-text"><b><i class="sw ap"></i>Measuring circle</b></span></label>
          </section>

          <section class="group">
            <h2>Image</h2>
            <label class="field range">
              <span class="lbl">Smoothing <output id="out-smooth">0 px</output></span>
              <input id="in-smooth" type="range" min="0" max="3" step="0.25" value="0" />
            </label>
          </section>

          <details class="more adv">
            <summary><svg class="ic chev"><use href="#i-chevron"></use></svg><svg class="ic"><use href="#i-sliders"></use></svg>More options</summary>
            <div class="adv-body">
              <label class="field">
                <span class="lbl">Snapshots to load</span>
                <select id="in-max">
                  <option value="24">24 · quick look</option>
                  <option value="48">48</option>
                  <option value="72" selected>72 · balanced</option>
                  <option value="120">120</option>
                  <option value="200">200</option>
                  <option value="9999">All available (slow)</option>
                </select>
                <small>Applies the next time you press “Show me the sky”.</small>
              </label>
              <label class="field">
                <span class="lbl">Compare against</span>
                <select id="in-diff">
                  <option value="none">Nothing</option>
                  <option value="median">The typical sky (median)</option>
                  <option value="prev">The previous snapshot</option>
                  <option value="first">The first snapshot</option>
                </select>
              </label>
              <div class="grid2c">
                <label class="field"><span class="lbl">Combine with</span><select id="in-comb"><option value="mean">Average</option><option value="median">Median</option></select></label>
                <label class="field"><span class="lbl">Pixel masking</span><select id="in-mask"><option value="standard">Standard</option><option value="strict">Strict</option></select></label>
              </div>
              <div class="grid2c">
                <label class="field"><span class="lbl">Contrast curve</span>
                  <select id="in-stretch"><option value="asinh" selected>Gentle (asinh)</option><option value="linear">Linear</option><option value="sqrt">Square root</option><option value="log">Log</option></select>
                </label>
                <label class="field"><span class="lbl">Colours</span>
                  <select id="in-cmap"><option value="invert" selected>Dark on light</option><option value="gray">Light on dark</option><option value="inferno">Inferno</option><option value="heat">Heat</option><option value="viridis">Viridis</option></select>
                </label>
              </div>
              <label class="field range"><span class="lbl">Brightest <output id="out-hi">99.8%</output></span><input id="in-hi" type="range" min="90" max="100" step="0.1" value="99.8" /></label>
              <label class="field range"><span class="lbl">Darkest <output id="out-lo">2%</output></span><input id="in-lo" type="range" min="0" max="50" step="0.5" value="2" /></label>
              <label class="switch compact"><input id="in-bg" type="checkbox" role="switch" checked /><span class="track"><i></i></span><span class="sw-text"><b>Remove the sky glow</b></span></label>
              <label class="switch compact"><input id="in-lock" type="checkbox" role="switch" /><span class="track"><i></i></span><span class="sw-text"><b>Same brightness scale for all</b></span></label>
              <label class="switch compact"><input id="in-pixel" type="checkbox" role="switch" /><span class="track"><i></i></span><span class="sw-text"><b>Show raw pixels</b></span></label>
              <label class="switch compact"><input id="in-masked" type="checkbox" role="switch" /><span class="track"><i></i></span><span class="sw-text"><b>Highlight masked pixels</b></span></label>
              <label class="switch compact"><input id="ov-wise" type="checkbox" role="switch" /><span class="track"><i></i></span><span class="sw-text"><b><i class="sw wise"></i>AllWISE sources</b></span></label>
              <p class="help">Keys: <kbd>Space</kbd> play/pause · <kbd>←</kbd> <kbd>→</kbd> step · <kbd>D</kbd> cycle comparison.</p>
            </div>
          </details>
        </aside>

        <section class="analysis glass" id="analysis" aria-label="Measure">
          <div class="analysis-head">
            <h2>Measure it</h2>
            <p>Click anywhere on the image to measure that spot. The measuring circle follows your click.</p>
          </div>
          <div class="tabs" role="tablist">
            <button role="tab" aria-selected="true" data-tab="spectrum" class="tab on"><svg class="ic"><use href="#i-bands"></use></svg>Brightness by colour</button>
            <button role="tab" aria-selected="false" data-tab="curve" class="tab"><svg class="ic"><use href="#i-wave"></use></svg>Brightness over time</button>
            <button role="tab" aria-selected="false" data-tab="list" class="tab"><svg class="ic"><use href="#i-image"></use></svg>Snapshots</button>
            <button role="tab" aria-selected="false" data-tab="context" class="tab"><svg class="ic"><use href="#i-target"></use></svg>Wider view</button>
          </div>

          <div class="pane on" data-pane="spectrum">
            <div class="pane-tools">
              <label class="field inline"><span class="lbl">Circle size <output id="out-ap">12″</output></span><input id="in-ap" type="range" min="6" max="40" step="1" value="12" /></label>
              <button class="btn quiet small" id="btn-ap-center" type="button">Back to centre</button>
              <button class="btn quiet small" id="btn-csv" type="button"><svg class="ic"><use href="#i-download"></use></svg><span>Download CSV</span></button>
            </div>
            <canvas id="plot-spec" class="plot"></canvas>
            <p class="help" id="meas-note"></p>
            <p class="help">Each dot is one snapshot. Its position left to right is the infrared wavelength SPHEREx saw at that spot. Higher means brighter. Dots are colour-coded by band.</p>
          </div>

          <div class="pane" data-pane="curve">
            <div class="pane-tools">
              <label class="field inline"><span class="lbl">Band</span>
                <select id="in-curve-det"><option value="0">All bands</option></select>
              </label>
            </div>
            <canvas id="plot-curve" class="plot"></canvas>
            <p class="help">Brightness at the measuring circle over time. Variable stars change from week to week. Click a dot to jump to that snapshot.</p>
          </div>

          <div class="pane" data-pane="list">
            <div class="table-wrap">
              <table class="frames" id="tbl">
                <thead><tr><th><span class="sr">Include</span></th><th>#</th><th>UTC</th><th>Band</th><th>λ (µm)</th><th>Time (s)</th><th>Valid</th><th>Flags near target</th><th>QA</th></tr></thead>
                <tbody id="tbody"></tbody>
              </table>
            </div>
            <p class="help">Untick a snapshot to leave it out of stacks and comparisons, for example one hit by a bright-star halo.</p>
          </div>

          <div class="pane" data-pane="context">
            <div id="context-box" class="context-box"><p class="help">Opens a wide-field map (Aladin Lite, CDS) of the same position so you can compare with other surveys.</p></div>
            <div class="pane-tools"><button class="btn small" id="btn-aladin" type="button">Load the map</button><a class="btn quiet small" id="link-aladin" target="_blank" rel="noopener">Open in a new tab</a></div>
          </div>
        </section>
      </section>
    </main>

    <dialog id="dlg-help" class="glass-dialog" aria-labelledby="help-title">
      <form method="dialog">
        <div class="dlg-head"><h2 id="help-title">How it works</h2><button class="btn quiet icon-only" value="close" aria-label="Close"><svg class="ic"><use href="#i-x"></use></svg></button></div>
        <ol class="howto">
          <li><b>Pick a spot.</b> Tap an example, or type a right ascension and declination (the sky's longitude and latitude).</li>
          <li><b>Watch it change.</b> The tool collects SPHEREx snapshots of that patch from NASA's archive and plays them as a film. Distant stars stay put. Anything close or fast shifts.</li>
          <li><b>Dig deeper.</b> Highlight what changed, group snapshots by infrared colour, or click a star to see its brightness at every colour and every date.</li>
        </ol>
        <h3>Words you'll meet</h3>
        <dl class="gloss">
          <dt>Snapshot</dt><dd>One SPHEREx exposure of your patch of sky. Each sees a slightly different infrared colour.</dd>
          <dt>Colour band (D1–D6)</dt><dd>The telescope has six detectors that together cover 0.75–5 µm. Brown dwarfs glow in the reddest ones.</dd>
          <dt>Brown dwarf</dt><dd>A ball of gas too small to be a star and too big to be a planet. Many are discovered because they drift against the background.</dd>
        </dl>
        <p class="help">Share a view with “Copy link”. Add <code>&amp;embed=1</code> to the address to embed only the viewer in another page. Data: SPHEREx spectral images (IRSA), Gaia DR3 (ESA), AllWISE (IRSA).</p>
        <menu><button class="btn primary" value="close">Got it</button></menu>
      </form>
    </dialog>

    <dialog id="dlg-picker" class="glass-dialog wide" aria-label="Change the spot">
      <div class="dlg-head"><h2>Change the spot</h2><button class="btn quiet icon-only" id="btn-picker-close" type="button" aria-label="Close"><svg class="ic"><use href="#i-x"></use></svg></button></div>
      <div id="picker-dialog-body"></div>
    </dialog>

    <script>
      import "../scripts/app.ts";
      import "../scripts/ui.ts";
    </script>
  </body>
</html>
